# Copy this file to ".env" and fill in your real values.
# The ".env" file itself should never be committed to Git (it's already
# in .gitignore) since it can hold real credentials.

SECRET_KEY=change-this-to-any-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartpos

# Optional — leave blank until you've created a bot via @BotFather.
TELEGRAM_BOT_TOKEN=8211179115:AAHZntU0uHHVggUUUrDPj5TkwZCds4wKruQ
TELEGRAM_CHAT_ID=-1003904132841

# Required for the "Forgot password" Telegram link to work from your
# PHONE. Must be your PC's LAN IP + Flask's port, NOT localhost/127.0.0.1
# (that means "this same device" and your phone can't resolve it back to
# your PC). Find it with `ipconfig` (Windows) or `ifconfig`/`ip a`
# (Mac/Linux) — look for the "IPv4 Address" on your WiFi adapter.
# Example:
PUBLIC_BASE_URL=http://127.0.0.1:5000/

